{
  "name": "@digital-gold/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "test": "npm run build && node --test dist/apps/api/src/**/*.test.js"
  },
  "dependencies": {
    "@digital-gold/shared": "0.1.0",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
